{
  "duracao": 57,
  "palavrasTotal": 180,
  "palavrasPorSegundo": 3.16,
  "segmentos": [
    {
      "t": 0.2,
      "fim": 3.4,
      "texto": "Quanto te custa não fazer o que tu ama?",
      "i": 1
    },
    {
      "t": 4.9,
      "fim": 9,
      "texto": "Eu pergunto porque quase todo mundo que me procura chega coberto de cinza.",
      "i": 2
    },
    {
      "t": 9,
      "fim": 12.6,
      "texto": "Faz tudo certo, posta todo dia, e ninguém lembra de quem é.",
      "i": 3
    },
    {
      "t": 13.2,
      "fim": 17.3,
      "texto": "Te venderam que disciplina resolve. Só que disciplina forçada é o que sobra quando a devoção foi embora.",
      "i": 4
    },
    {
      "t": 17.7,
      "fim": 21.6,
      "texto": "Quem ama o que faz não precisa se forçar, não performa, não busca atalho.",
      "i": 5
    },
    {
      "t": 22.2,
      "fim": 25.4,
      "texto": "De zero a dez, o quanto tu tá morno hoje?",
      "i": 6
    },
    {
      "t": 27.5,
      "fim": 31.3,
      "texto": "Porque o morno não marca ninguém. Nem quem faz, nem quem assiste.",
      "i": 7
    },
    {
      "t": 32.3,
      "fim": 37.3,
      "texto": "Nos meus atendimentos, quatro de cada cinco pessoas entendem o que tu faz na hora, quando tu para de explicar e começa a mostrar.",
      "i": 8
    },
    {
      "t": 37.9,
      "fim": 43,
      "texto": "É por isso que o meu processo começa no raio-x, depois a frase, o filtro, o eixo, e só no fim o antes e depois.",
      "i": 9
    },
    {
      "t": 43.6,
      "fim": 47.5,
      "texto": "Primeiro tu descobre o que é cinza. Depois tu para de apagar o que é brasa.",
      "i": 10
    },
    {
      "t": 48.3,
      "fim": 52.5,
      "texto": "O fogo é a vida, mas ele acaba em si. O que fica é a brasa.",
      "i": 11
    },
    {
      "t": 53.5,
      "fim": 57,
      "texto": "E a brasa é o que tu não consegue não mostrar.",
      "i": 12
    }
  ],
